# Copy file ini jadi .env, terus isi dari Supabase > Project Settings > API
# (URL = "Project URL", ANON_KEY = key "anon" / "publishable").
# Anon key ini memang aman ditaruh di website: aksesnya dibatasin sama aturan
# di supabase/schema.sql. JANGAN pernah taruh key "service_role" di sini.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-di-sini
